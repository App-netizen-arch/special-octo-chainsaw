# ============================================================
# Counsel AI — copy to `.env` and edit.
# ============================================================

# --- Backend server ---
COUNSEL_HOST=127.0.0.1
COUNSEL_PORT=8000
# Token the Flutter app must send (X-API-Token header or ?token= for WS).
# Keep the default only for local development.
COUNSEL_TOKEN=counsel-dev-token
COUNSEL_CORS_ORIGINS=*

# Where conversations.sqlite, uploads, outputs and the vector index live.
COUNSEL_DATA_DIR=./data

# --- Local LLM (llama.cpp via llama-cpp-python) ---
# Full path to a GGUF model file. Example:
#   https://huggingface.co/bartowski/Llama-3.2-3B-Instruct-GGUF
LOCAL_MODEL_PATH=
LOCAL_CTX_SIZE=8192
LOCAL_GPU_LAYERS=0        # >0 offloads layers to GPU if compiled with CUDA/Metal
LOCAL_TEMPERATURE=0.3

# --- API LLM (any OpenAI-compatible endpoint) ---
API_BASE_URL=https://api.deepseek.com/v1
API_MODEL=deepseek-chat
# Server-side fallback key. Preferred flow: enter the key in the app Settings;
# it is stored in the OS keychain there and forwarded per-request.
API_KEY=

# --- Web search (legitimate sources only) ---
SEARCH_PROVIDER=tavily          # tavily | searxng | auto
TAVILY_API_KEY=
SEARXNG_URL=http://localhost:8888

# --- Research agent tuning ---
RESEARCH_MAX_SUBQUERIES=3
RESEARCH_MAX_RESULTS=6
RESEARCH_MAX_PAGE_CHARS=6000
RESEARCH_MAX_CONTEXT_CHARS=24000
